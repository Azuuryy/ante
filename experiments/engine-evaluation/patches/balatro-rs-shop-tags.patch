+    fn acquire_tag(&mut self, tag: Tag, orbital: Option<HandRank>) {
+        let copies = if tag == Tag::Double {
+            1
+        } else {
+            let before = self.tags.len();
+            self.tags.retain(|tag| *tag != Tag::Double);
+            1 + before - self.tags.len()
