+                            break;
+                        }
+                        let mut joker = self.backend.gen_joker_of_rarity(
+                            self.ante_current.number() as i32,
+                            self.prob_mult,
+                            &self.jokers,
+                            Rarity::Common,
+                        );
+                        joker.set_edition(Edition::Base);
+                        self.backend.on_joker_bought(&joker);
+                        self.jokers.push(joker);
+                    }
+                    self.effect_registry
